{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "allowJs": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vite/client"],
    "resolveJsonModule": true,
    "outDir": "dist"
  },
  "include": ["client/src", "server/**/*.ts", "shared/**/*.ts"],
  "exclude": ["node_modules"]
}
